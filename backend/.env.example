# Bu dosyayı backend/.env olarak kopyalayın ve değerleri düzenleyin.

# Yerel geliştirme: docker compose ile açılan veritabanı (host portu POSTGRES_PORT, varsayılan 5432)
DATABASE_URL=postgresql+psycopg://erp:erp@localhost:5432/erp

# Testler bu veritabanını kullanır; testler tabloları sıfırlayabilir, geliştirme veritabanını vermeyin.
TEST_DATABASE_URL=postgresql+psycopg://erp:erp@localhost:5432/erp_test

# JWT imzalama anahtarı (en az 32 karakter; aşağıdaki örnek değer kabul edilmez). Üretmek için:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Virgülle ayrılmış ek frontend adresleri (localhost:5173 her zaman izinlidir)
CORS_ORIGINS=

# Deney 1: stok kilidi stratejisi (pessimistic = SELECT ... FOR UPDATE, optimistic = sürüm numarası)
STOCK_STRATEGY=pessimistic

# Swagger/ReDoc/OpenAPI (/docs, /redoc, /openapi.json). Üretimde false yapın.
ENABLE_DOCS=true

# Veritabanı bağlantı havuzu (worker başına)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Uygulama günlük düzeyi (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
