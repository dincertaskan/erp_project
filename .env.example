# docker compose ayarları. İsteğe bağlıdır; kök dizinde .env olarak kopyalayın.
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp
# Bilgisayarınızda 5432 doluysa başka bir port seçin ve backend/.env içindeki adresleri de güncelleyin.
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Yalnızca docker-compose.prod.yml için (zorunlu): güçlü bir veritabanı şifresi ve en az 32 karakterlik SECRET_KEY.
# SECRET_KEY üretmek için: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=
# HTTP_PORT=80
